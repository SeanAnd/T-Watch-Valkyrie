// Default preferences for the Valkyrie fork overlay.
//
// IMPORTANT: this file is NEVER read by the firmware at build time.
// It is documentation only. The compiled defaults live in
// forks/valkyrie/prefs/ValkyriePrefs.cpp::ValkyriePrefs::defaults().
//
// We deliberately ship our own jsonc rather than touching upstream's
// firmware/userPrefs.jsonc so that running the upstream
// `bin/build-userprefs-json.py` flow stays a clean no-op for our keys.
{
    // Phase 1: BLE threat detector
    "bleThreatDetectorEnabled": true,

    // target seconds between scan window *starts* (must be >= 30). Idle gap =
    // max(0, scanIntervalSecs - scanWindowSecs).
    "scanIntervalSecs": 30,

    // length of each passive BLE scan window, seconds
    "scanWindowSecs": 10,

    // skip scans while battery is below this percentage
    "minBatteryPct": 20,

    // re-emit the same (mac, threat type) at most once per this window, seconds
    "dedupeWindowSecs": 60,

    // bits 0..5 enable Airtag..Drone threat scanning (0x3F = all on); NVS key scan_msk
    "threatScanMask": 63,

    // NimBLE passive window each duty pass when true; NVS key ble_phs
    "bleThreatPhaseEnabled": true,

    // no idle gap between BLE scan windows when true (higher power); NVS key const_scn
    "constantBleScanMode": false,

    // passive threat detection only (`emitDetection`); NVS key thr_hapt
    "threatDetectionHapticEnabled": true,

    // passive threat detection only, HAS_I2S builds; NVS key thr_snd
    "threatDetectionSoundEnabled": true,

    // gates all phone push (sendToPhone + sendClientNotification); NVS key phn_notif
    "phoneNotificationsEnabled": true,

    // AirTag GPS stalking gate (NVS keys stk_sig, stk_plc, stk_sep, stk_ttl)
    "stalkMinSightings": 3,
    "stalkMinDistinctPlaces": 2,
    "stalkMinSeparationM": 75,
    "stalkEntryTtlSecs": 172800,

    // Wi‑Fi promiscuous phase (after BLE window or standalone); NVS keys wifi_en, wifi_msk, wifi_ms, wifi_dw
    "wifiThreatPhaseEnabled": true,
    "wifiThreatScanMask": 31,
    // Default matches scanWindowSecs (10 s) → 10000 ms; see ValkyriePrefs::defaults().
    "wifiThreatPassMs": 10000,
    "wifiThreatChannelDwellMs": 350,

    // Wardrive (Wi‑Fi only, session-based; tap-to-stop). NVS keys wd_req_fix, wd_per_ms, wd_phn.
    // wardriveRequireFix: when true, skip Wigle rows while getHasUsablePosition() is false (no on-device
    // GPS fix, no fixed_position, and no fresh phone-supplied localPosition). Same "No Fix" guard as Marauder.
    "wardriveRequireFix": true,
    // ms between consecutive WiFi.scanNetworks bursts during a session. Clamped to [1000, 60000].
    // Default 10 s trades row density for BLE / phone-supplied GPS health (paired with passive scan).
    "wardriveScanPeriodMs": 10000,
    // forward classifier hits during a drive to the phone (PRIVATE_APP + ClientNotification). When off
    // the drive is silent on the phone link (CSV still records, threats still write to threats.log).
    "wardrivePhoneNotify": true
}
